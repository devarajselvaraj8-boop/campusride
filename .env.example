# CampusRide Notification Server Configuration (Example)
# DO NOT put real service-account credentials or private keys in this file.

PORT=3000
NODE_ENV=development

# Firebase Project Configuration
FIREBASE_PROJECT_ID=campusride-7a9be

# Path to the service account JSON credential (stored locally outside Git in secrets/)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Development secret for protecting the /test-notification endpoint
DEV_TEST_SECRET=campusride_dev_test_secret_key_change_me

# Allowed CORS Origins (comma-separated, restricted in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

